{
  "version": 2,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/",
      "destination": "/index%20%281%29.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/outbox-and-retention",
      "schedule": "0 9 * * *"
    }
  ]
}
